# SmartCart AI Storefront Environment Configuration

# Storefront URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_STOREFRONT_LOCALES=en
STOREFRONT_CHANNELS=default-channel

# FastAPI Backend REST API
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Content Provider Mode (code defaults, no Saleor CMS dependency)
CONTENT_PROVIDER=code

# Image Remote Hosts (DummyJSON CDN, Unsplash)
IMAGE_ALLOWED_HOSTS=cdn.dummyjson.com,dummyjson.com,images.unsplash.com
